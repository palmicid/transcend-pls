// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  display_name  String   @default("player") //how to add ID here?
  avatar_url    String   @default("/default_avatar.jpg") //default pic here
  online_status  Boolean  @default(false)
  last_active_at DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at    DateTime @updatedAt
  secret        String   @default("")
  is_verified   Boolean  @default(false)
  use2FA        Boolean  @default(true)

  // Google Auth Relation
  googleAuth oauth[]

  // Relations
  sentRequests     FriendRelation[] @relation("SentRequests")
  receivedRequests FriendRelation[] @relation("ReceivedRequests")

  // Room relations
  ownedRooms Room[]       @relation("RoomOwner")
  rooms      RoomPlayer[] @relation("RoomPlayers")

  // Game Results
  gamesAsPlayer1 GameResult[] @relation("GamePlayer1")
  gamesAsPlayer2 GameResult[] @relation("GamePlayer2")
  gamesWon       GameResult[] @relation("GameWinner")

  // Progression
  xp            PlayerXP?
  achievements  UserAchievement[]

  @@index([online_status, last_active_at])
}

// Friendships Model
model FriendRelation {
  id Int @id @default(autoincrement())

  user_id Int
  sender  User @relation("SentRequests", fields: [user_id], references: [id])

  friend_id Int
  friend    User @relation("ReceivedRequests", fields: [friend_id], references: [id])

  is_accepted Boolean  @default(false)
  created_at  DateTime @default(now())

  @@unique([user_id, friend_id])
}

// (Game_ttt model removed)

// Google Authentication Model
model oauth {
  oauth_id       String   @id
  refresh_token  String
  access_token   String
  granted_scopes String
  expiry_date    DateTime
  user_id        Int
  user           User     @relation(fields: [user_id], references: [id])
}

// Room Model for game lobbies
model Room {
  id           String  @id
  owner_id     Int
  owner        User    @relation("RoomOwner", fields: [owner_id], references: [id])
  game_type    String  @default("tic-tac-toe")
  status       String  @default("OPEN") // OPEN, READY, IN_GAME, ENDED
  max_players  Int     @default(2)
  board_state  Json?   @default("[]")
  current_turn String?
  winner_role  String?

  // Bot configuration
  bot_difficulty String? // null = no bot, "Easy" | "Medium" | "Hard"
  bot_role       String? // "X" or "O" - which slot the bot occupies
  bot_delay_ms   Int     @default(500) // Delay before bot moves (ms)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  players RoomPlayer[]
}

// Room Player Model
model RoomPlayer {
  room_id   String
  room      Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user_id   Int
  user      User     @relation("RoomPlayers", fields: [user_id], references: [id], onDelete: Cascade)
  role      String // "X" or "O" for tic-tac-toe
  joined_at DateTime @default(now())

  @@id([room_id, user_id])
  @@unique([room_id, user_id])
}

/// Permanent record of completed games (remote only, no bots)
model GameResult {
  id Int @id @default(autoincrement())

  game_type String // "tic-tac-toe", "connect4"
  room_id   String? // Optional link to source Room
  final_board Json?

  player1_id Int
  player1    User @relation("GamePlayer1", fields: [player1_id], references: [id])
  player1_role String? // e.g. "X", "Red"
  player2_id Int
  player2    User @relation("GamePlayer2", fields: [player2_id], references: [id])
  player2_role String? // e.g. "O", "Yellow"

  winner_id Int? // null = draw
  winner    User?   @relation("GameWinner", fields: [winner_id], references: [id])
  is_draw   Boolean @default(false)

  duration_ms Int?
  xp_awarded_p1 Int @default(0)   // XP player1 earned from this game
  xp_awarded_p2 Int @default(0)   // XP player2 earned from this game

  started_at DateTime
  ended_at   DateTime @default(now())

  @@index([player1_id])
  @@index([player2_id])
  @@index([winner_id])
  @@index([game_type])
  @@index([room_id])
  @@index([ended_at])
}

/// Player XP and level tracking (1:1 with User)
model PlayerXP {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id])
  total_xp   Int      @default(0)
  level      Int      @default(1)
  updated_at DateTime @updatedAt

  @@index([total_xp]) // for leaderboard queries
}

/// Record of a user unlocking an achievement
model UserAchievement {
  id             Int      @id @default(autoincrement())
  user_id        Int
  user           User     @relation(fields: [user_id], references: [id])
  achievement_id String   // matches code-defined achievement key
  unlocked_at    DateTime @default(now())

  @@unique([user_id, achievement_id]) // prevent double-unlocking
  @@index([user_id])
}
